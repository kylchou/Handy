# ---------- Backend API (apps/api) ----------
API_PORT=4000
API_HOST=0.0.0.0

# Database. Two options:
#   1. Zero-setup embedded Postgres (PGlite), stored under <repo>/.data/handy:
DATABASE_URL=pglite://.data/handy
#   2. A real PostgreSQL server:
# DATABASE_URL=postgres://handy:handy@localhost:5432/handy

# Change this for anything other than local development.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Timezone used to interpret "today"/"tomorrow" and worker schedules.
APP_TIMEZONE=America/New_York

# Seed demo data (categories, demo customer, demo workers) when the DB is empty.
SEED_ON_START=true

# Matching / broadcasting
MATCH_INITIAL_OFFERS=5
MATCH_EXPAND_AFTER_SECONDS=120
# How long a worker has to respond to an offer before it goes to someone else.
MATCH_OFFER_TTL_SECONDS=300
PLATFORM_FEE_CENTS=500

# Turns addresses into map coordinates using OpenStreetMap (free, no key needed).
# Set GEOCODER_CONTACT to an email or URL so they can reach you, it's part of their usage policy.
# GEOCODER=off skips lookups and uses the customer's home location instead.
GEOCODER=nominatim
GEOCODER_CONTACT=

# Interactive API docs at http://localhost:4000/docs. Off by default when NODE_ENV=production.
DOCS_ENABLED=true

# Limits on login, signup, and the AI chat. Only turn off for local testing.
RATE_LIMIT_ENABLED=true

# Lets an admin reset the demo data with POST /api/v1/admin/demo/reset.
# Off by default when NODE_ENV=production.
ALLOW_DEMO_RESET=true

# Module names for Engineer 3's services. If they cannot be loaded, the API
# falls back to its built-in rule-based assistant and deterministic matcher.
AI_SERVICE_MODULE=@handy/ai
MATCHING_SERVICE_MODULE=@handy/matching

# AI keys for @handy/ai. Real keys go in .env only, never commit them.
# Both empty = API starts with its built-in rule-based assistant instead.
# Meta Model API (Muse Spark) key. Used first when set.
MODEL_API_KEY=
# Claude key. Used when MODEL_API_KEY is empty.
ANTHROPIC_API_KEY=
# Force one provider when both keys are set: muse or anthropic.
# AI_PROVIDER=muse
# Optional: AI_MODEL (default muse-spark-1.3 or claude-opus-5), AI_EFFORT (Claude only: low | medium | high)
