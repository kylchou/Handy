{
  "name": "handy",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @handy/api dev",
    "dev:customer": "pnpm --filter @handy/customer dev",
    "dev:worker": "pnpm --filter @handy/worker dev",
    "demo": "pnpm --filter @handy/api demo",
    "start": "pnpm --filter @handy/api start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @handy/db generate",
    "db:migrate": "pnpm --filter @handy/db migrate",
    "db:seed": "pnpm --filter @handy/db seed",
    "db:reset": "pnpm --filter @handy/db reset"
  }
}
